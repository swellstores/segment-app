{
  "$schema": "https://json.swell.store/setting.json",
  "label": "Segment",
  "description": "Send store events to Segment as track calls.",
  "fields": [
    {
      "id": "write_key",
      "label": "Segment write key",
      "type": "short_text",
      "required": true,
      "description": "Find and enter the write key from your Segment account (Connections \u2192 Sources \u2192 your source \u2192 Settings \u2192 API Keys)."
    },
    {
      "id": "region",
      "label": "Segment region",
      "type": "select",
      "default": "us",
      "description": "Region of your Segment workspace.",
      "options": [
        {
          "value": "us",
          "label": "US (api.segment.io)"
        },
        {
          "value": "eu",
          "label": "EU (events.eu1.segmentapis.com)"
        }
      ]
    },
    {
      "id": "enabled",
      "label": "Enabled",
      "type": "boolean",
      "ui": "toggle",
      "default": true,
      "description": "Turn off to pause sending events without losing your configuration."
    },
    {
      "type": "field_group",
      "label": "Events",
      "description": "Select the store events to send to Segment. Nothing is sent until at least one event is selected.",
      "fields": [
        {
          "id": "events_account",
          "label": "Account",
          "type": "checkboxes",
          "options": [
            {
              "value": "account.created",
              "label": "account.created"
            },
            {
              "value": "account.updated",
              "label": "account.updated"
            },
            {
              "value": "account.deleted",
              "label": "account.deleted"
            },
            {
